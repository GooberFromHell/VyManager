{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Status",
  "description": "Real-time status of an agent's task execution. Updated on every significant state change.",
  "type": "object",
  "required": ["task_id", "agent_role", "status", "updated_at"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(ARCH|IMPL|TEST|REVIEW|KB)-[0-9]{3,}$"
    },
    "agent_role": {
      "type": "string",
      "enum": ["architect", "implementer", "tester", "reviewer", "knowledge-broker"]
    },
    "status": {
      "type": "string",
      "enum": ["queued", "blocked", "in_progress", "complete", "partial", "failed"],
      "description": "queued: ready to start. blocked: waiting on upstream. in_progress: agent is working. complete/partial/failed: agent has finished."
    },
    "progress_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string"
    },
    "files_modified": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_created": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tokens_consumed": {
      "type": "object",
      "properties": {
        "context": { "type": "integer" },
        "output": { "type": "integer" }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Task IDs or descriptions of what is blocking this task"
    },
    "notes": {
      "type": "string"
    }
  }
}
